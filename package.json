{
  "name": "@mikaelcedergren/cx-framework",
  "version": "0.8.1",
  "description": "Personal Angular UI framework and AI design package.",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "bin": {
    "cx-framework-skills": "./scripts/install-ai-skills.mjs"
  },
  "main": "./dist/lib/public-api.js",
  "module": "./dist/lib/public-api.js",
  "types": "./dist/lib/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/public-api.d.ts",
      "default": "./dist/lib/public-api.js"
    },
    "./PACKAGING.md": "./PACKAGING.md",
    "./README.md": "./README.md",
    "./package.json": "./package.json",
    "./ai": "./ai/design/00-start-here.md",
    "./ai/*": "./ai/*",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./scripts/*": "./scripts/*",
    "./styles/*": {
      "sass": "./styles/_*.scss",
      "default": "./styles/_*.scss"
    },
    "./support/*": "./support/*",
    "./tokens": {
      "sass": "./tokens/index.scss",
      "default": "./tokens/index.scss"
    },
    "./tokens/*": {
      "sass": "./tokens/_*.scss",
      "default": "./tokens/_*.scss"
    }
  },
  "files": [
    "README.md",
    "PACKAGING.md",
    "dist/",
    "AGENTS.md",
    "ai/",
    "fonts/",
    "icons/",
    "patterns/",
    "primitives/",
    "public-api.ts",
    "scripts/",
    "styles/",
    "support/",
    "theme.ts",
    "tokens/",
    "tooling/",
    "tsconfig.lib.json",
    "typeface.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icon-manifest.mjs",
    "icons:check": "node scripts/generate-icon-index.mjs --check",
    "icons:index": "node scripts/generate-icon-index.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "dependencies": {
    "ag-charts-community": "^13.3.1",
    "marked": "^18.0.7",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "ng-packagr": "^22.0.2",
    "rxjs": "^7.8.2",
    "sass": "^1.102.0",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/cx-framework.git"
  },
  "bugs": {
    "url": "https://github.com/mikaelcedergren/cx-framework/issues"
  },
  "homepage": "https://github.com/mikaelcedergren/cx-framework#readme",
  "sideEffects": [
    "**/*.scss"
  ]
}
